# Copy to a private file outside Git (for example /etc/dr-screening/webapp.env or %LOCALAPPDATA%\DRScreening\webapp.env).
# Replace every REPLACE value. Never commit the real file.
DR_SCREENING_SOURCE_COMMIT=REPLACE_WITH_40_CHARACTER_GIT_SHA
DR_SCREENING_IMAGE_TAG=local
DR_SUPPORT_POSTGRES_DB=dr_support
DR_SUPPORT_POSTGRES_USER=dr_support
DR_SUPPORT_POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# AI model server: the hospital model server (package 2 gateway) or the team server through an approved route
REMOTE_MODEL_URL=http://REPLACE_HOST:8880
REMOTE_MODEL_TOKEN=REPLACE_WITH_THE_MODEL_SERVER_TOKEN
# Folders on this machine
DR_DATA_DIR=./data
DR_IMAGES_DIR=./images
# HTTPS address users type in the browser, and where it listens (0.0.0.0 to serve the hospital network)
DR_SITE_ADDRESS=localhost
DR_HTTPS_BIND=127.0.0.1

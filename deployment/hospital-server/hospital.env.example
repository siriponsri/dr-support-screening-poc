# Copy to /etc/dr-screening/hospital.env (root-owned, mode 600). Replace every REPLACE value. Never commit the real file.
# GPU profile and model assets: see ../dual-mode/profiles/hospital-3090.env.example and ../dual-mode/GPU_COMPATIBILITY.md
DUAL_MODE_GPU_PROFILE=hospital-3090
DR_SCREENING_SOURCE_COMMIT=REPLACE_WITH_40_CHARACTER_GIT_SHA
DR_SCREENING_IMAGE_TAG=local
MODEL_API_BASE_IMAGE=pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime
USPEC_GPU_ID=0
PRISM_GPU_ID=0
RETFOUND_GPU_ID=0
# Verified model assets on this server, mounted read-only (checked against pinned hashes at start)
USPEC_MODEL_DIR=/srv/dr-screening/models/uspec
PRISM_SOURCE=/srv/dr-screening/models/PRISM-DR
PRISM_WEIGHTS=/srv/dr-screening/models/prism
RETFOUND_SOURCE=/srv/dr-screening/models/RETFound
RETFOUND_WEIGHTS=/srv/dr-screening/models/retfound-aptos.pth
DR_SUPPORT_POSTGRES_DB=dr_support
DR_SUPPORT_POSTGRES_USER=dr_support
DR_SUPPORT_POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
REMOTE_MODEL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
# Folders (keep data and images off the system disk)
DR_DATA_DIR=/srv/dr-screening/data
DR_IMAGES_DIR=/srv/dr-screening/images
# Address users type in the browser on the hospital network
DR_SITE_ADDRESS=dr-screening.hospital.local
DR_HTTPS_BIND=0.0.0.0

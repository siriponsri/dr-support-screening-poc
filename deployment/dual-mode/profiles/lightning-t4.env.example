# Copy to a private, untracked environment file and export it before Compose.
# This profile is the only portable profile whose GPU is present on the current host.
DUAL_MODE_GPU_PROFILE=lightning-t4
MODEL_API_BASE_IMAGE=pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime
USPEC_GPU_ID=0
PRISM_GPU_ID=0
RETFOUND_GPU_ID=0
# Set all model paths to external read-only directories; never commit these values.
USPEC_MODEL_DIR=/private/models/uspec
PRISM_SOURCE=/private/models/PRISM-DR
PRISM_WEIGHTS=/private/models/prism
RETFOUND_SOURCE=/private/models/RETFound
RETFOUND_WEIGHTS=/private/models/retfound-aptos.pth
DR_SUPPORT_POSTGRES_DB=dr_support
DR_SUPPORT_POSTGRES_USER=dr_support
DR_SUPPORT_POSTGRES_PASSWORD=REPLACE_IN_PRIVATE_ENV
REMOTE_MODEL_TOKEN=REPLACE_IN_PRIVATE_ENV

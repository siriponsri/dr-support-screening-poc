# Hospital M1 QA Server: private, explicitly approved Model API route.
# This is a template, not evidence of hospital VLAN/backend reachability.
DR_SUPPORT_DEPLOYMENT_PROFILE=QA_SERVER
APP_PROFILE=review
MODEL_RUNTIME=remote
HOST=127.0.0.1
PORT=8000
WORKERS=1
# Set the backend-reachable URL after verifying the approved route/tunnel.
# Remote 127.0.0.1 requires a live tunnel and its verified local mapping.
REMOTE_MODEL_URL=
# Supply the existing approved token privately; never put it in this template.
REMOTE_MODEL_TOKEN=
# Blank selects the existing project-owned local PostgreSQL startup path.
# Otherwise supply an approved hospital PostgreSQL URL privately.
DR_SUPPORT_DATABASE_URL=
DR_SUPPORT_CASE_STORE=postgres

# Tesla P40 profile template. NOT_RUN on the current host.
# Replace MODEL_API_BASE_IMAGE only after target-host CUDA/PyTorch preflight.
DUAL_MODE_GPU_PROFILE=ceo-p40
MODEL_API_BASE_IMAGE=REPLACE_WITH_P40_COMPATIBLE_IMAGE
USPEC_GPU_ID=0
PRISM_GPU_ID=0
RETFOUND_GPU_ID=0
USPEC_MODEL_DIR=/private/models/uspec
PRISM_SOURCE=/private/models/PRISM-DR
PRISM_WEIGHTS=/private/models/prism
RETFOUND_SOURCE=/private/models/RETFound
RETFOUND_WEIGHTS=/private/models/retfound-aptos.pth
DR_SUPPORT_POSTGRES_DB=dr_support
DR_SUPPORT_POSTGRES_USER=dr_support
DR_SUPPORT_POSTGRES_PASSWORD=REPLACE_IN_PRIVATE_ENV
REMOTE_MODEL_TOKEN=REPLACE_IN_PRIVATE_ENV

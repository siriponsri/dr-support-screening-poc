# Hospital M1 QA Local: all dependencies, images, weights and services local.
# Prepare and verify offline assets/dependencies before installation.
DR_SUPPORT_DEPLOYMENT_PROFILE=QA_LOCAL
APP_PROFILE=review
MODEL_RUNTIME=remote
HOST=127.0.0.1
PORT=8000
WORKERS=1
# Set the verified local Model API/tunnel port, or http://model-gateway:<port>
# only when the review backend is in that existing private Compose network.
# Empty is intentionally fail-closed; no external fallback is permitted.
REMOTE_MODEL_URL=
# Supply the approved local service token privately.
REMOTE_MODEL_TOKEN=
# Blank selects project-owned local PostgreSQL. An explicit URL must point
# to the approved hospital-local database; never supply dr-train credentials.
DR_SUPPORT_DATABASE_URL=
DR_SUPPORT_CASE_STORE=postgres

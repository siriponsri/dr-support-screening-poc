FROM node:22-alpine AS frontend-build
RUN apk add --no-cache git
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
ARG SOURCE_COMMIT=portable-source-unpinned
ENV DR_FRONTEND_SOURCE_COMMIT=$SOURCE_COMMIT
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY pyproject.toml README.md ./
COPY dr_support ./dr_support
COPY web ./web
COPY --from=frontend-build /src/frontend/dist ./frontend/dist
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
      'fastapi==0.141.1' 'uvicorn==0.53.0' 'httpx==0.28.1' \
      'pydantic==2.13.5' 'Pillow==12.3.0' 'psycopg[binary]==3.2.10' \
    && python -m pip install --no-cache-dir --no-deps -e .
ENV APP_PROFILE=review MODEL_RUNTIME=remote HOST=0.0.0.0 PORT=8000 WORKERS=1
EXPOSE 8000
CMD ["python", "-m", "dr_support.run"]

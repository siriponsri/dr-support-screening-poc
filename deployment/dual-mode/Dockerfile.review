ARG FRONTEND_BASE_IMAGE=node:22-alpine
ARG REVIEW_BASE_IMAGE=python:3.12-slim
FROM ${FRONTEND_BASE_IMAGE} AS frontend-build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
ARG SOURCE_COMMIT
ENV DR_FRONTEND_SOURCE_COMMIT=$SOURCE_COMMIT
RUN node -e "if (!/^[a-f0-9]{40}$/.test(process.env.DR_FRONTEND_SOURCE_COMMIT || '')) process.exit(1)"
RUN npm run build

FROM ${REVIEW_BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY deployment/dual-mode/review-requirements.lock /tmp/review-requirements.lock
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
      --require-hashes --only-binary=:all: --no-deps -r /tmp/review-requirements.lock
COPY dr_support ./dr_support
COPY web ./web
COPY --from=frontend-build /src/frontend/dist ./frontend/dist
# Run the copied module directly; avoid an unlocked build-isolation install.
RUN useradd --uid 10001 --create-home review \
    && mkdir -p /data/state /data/output \
    && chown review:review /data/state /data/output
ENV APP_PROFILE=review MODEL_RUNTIME=remote HOST=0.0.0.0 PORT=8000 WORKERS=1 \
    DR_SUPPORT_CASE_STORE=postgres \
    DR_SUPPORT_STATE=/data/state/reviews.sqlite \
    DR_SUPPORT_WORKSPACE_CATALOG=/data/state/workspaces.sqlite
USER 10001:10001
EXPOSE 8000
# Liveness only: database/workspace/model readiness needs separate qualification.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import json,sys,urllib.request; p=json.load(urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)); sys.exit(0 if p.get('status') in {'PASS','PASS_WITH_WARNINGS'} else 1)"
CMD ["python", "-m", "dr_support.run"]

# Copy to /etc/dr-support/model-server.env and edit for the host.
APP_PROFILE=model_api
MODEL_RUNTIME=local
# Loopback by default; reach it through an SSH or private-network tunnel. Change only with the token set.
HOST=127.0.0.1
PORT=7860
WORKERS=1
INFERENCE_DEVICE=cuda:0
MODEL_REQUIRE_VERIFIED_ASSETS=1
DR_SUPPORT_RELAX_DEVICE=0
# Required: at least 32 random characters, kept only in this private file.
REMOTE_MODEL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

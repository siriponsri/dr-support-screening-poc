# Copy to %LOCALAPPDATA%\DRScreening\M1PrivateConfig\demo.env and fill in. Never commit the real file.
# Only public or consented images may be sent to dr-train (hospital rule, 31 October 2026).
# Your own dr-train login (name@address) and the private SSH key file for it. Both are required.
DR_HOST=your-name@dr-train-address
DR_KEY=C:/Users/<you>/.ssh/<your dr-train key>
# Optional: your personal model token file (personal access; see docs/developer/DR_TRAIN_ACCESS.md)
# DR_TOKEN_FILE=C:/Users/<you>/AppData/Local/DRScreening/M1PrivateConfig/model-token.txt
# Optional: the project folder on dr-train, if it is not the one the deployed gateway uses
# DR_REMOTE_PROJECT=/home/<account>/projects/dr-model-api-qa
# dr-train deployment, PRISM pins and daily-authority state (see docs/developer/MODEL_SERVER_OPERATIONS.md)
DR_DEPLOY=regular-20261031-r05
DR_PINS_REMOTE=regular/r04-inputs/PRISM_WORKSPACE_PINS.json
DR_STATE=r01
# The same PRISM pins on this workstation
DR_PINS_LOCAL=C:/Users/<you>/AppData/Local/DRScreening/M1PrivateConfig/regular-20261031-r04/PRISM_WORKSPACE_PINS.json
# Workspace with public or consented images only
DR_WORKSPACE=ws_m1_xxxxxxxxxxxxxxxxxxxx
DR_WORKSTATION=owner-ws-1
# workspace | public-samples | public-folder (then also set DR_PUBLIC_FOLDER)
DR_IMAGES=workspace
DR_APP_PORT=8010
DR_MODEL_PORT=47860

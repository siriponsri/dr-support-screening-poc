# Copy to %LOCALAPPDATA%\DRScreening\M1PrivateConfig\demo.env and fill in. Never commit the real file.
# Only public or consented images may be sent to dr-train (hospital rule, 31 October 2026).
DR_HOST=siripon@100.77.149.83
DR_KEY=C:/Users/User/.ssh/id_ed25519_dr_train
# dr-train deployment, PRISM pins and daily-authority state (see docs/operations/REGULAR_SERVICE_OPERATIONS.md)
DR_DEPLOY=regular-20261031-r04
DR_PINS_REMOTE=regular/r04-inputs/PRISM_WORKSPACE_PINS.json
DR_STATE=r01
# The same PRISM pins on this workstation
DR_PINS_LOCAL=C:/Users/User/AppData/Local/DRScreening/M1PrivateConfig/regular-20261031-r04/PRISM_WORKSPACE_PINS.json
# Workspace with public or consented images only
DR_WORKSPACE=ws_m1_xxxxxxxxxxxxxxxxxxxx
DR_WORKSTATION=owner-ws-1
# workspace | public-samples | public-folder (then also set DR_PUBLIC_FOLDER)
DR_IMAGES=workspace
DR_APP_PORT=8010
DR_MODEL_PORT=47860

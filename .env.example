# Retinal Review Workbench runtime configuration.
# Copy this file to a private environment file; never commit secrets.
# This public template is not a deploy-ready environment. Container operators
# inject a private PostgreSQL URL; the container never provisions a database.
# Native HOST stays loopback. Container-specific HOST/PORT and mounts are covered
# in docs/operations/REPO_HYGIENE.md; do not copy this template unchanged to Docker.
# Validate this template without loading any private .env:
# python scripts/audit/check_repo_hygiene.py --tracked-paths-file <git-path-list>

# review: clinician workstation; model_api: hospital GPU service;
# full: public/synthetic local demo.
APP_PROFILE=review
MODEL_RUNTIME=remote
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Hospital M1 candidate: select QA_SERVER or QA_LOCAL in private configuration.
# Leave blank only for the existing developer workflow. QA_LOCAL pins the
# endpoint below to loopback (or the existing Compose gateway) and refuses
# external/manual overrides. This selection is not a hospital acceptance pass.
DR_SUPPORT_DEPLOYMENT_PROFILE=

# Clinician workstation -> hospital Model API connection.
REMOTE_MODEL_URL=
REMOTE_MODEL_TOKEN=

# Legacy SQLite paths are compatibility-only. Leave blank for managed PostgreSQL.
DR_SUPPORT_STATE=
DR_SUPPORT_WORKSPACE_CATALOG=

# Managed PostgreSQL is the normal workstation store. Use sqlite explicitly only
# for a legacy compatibility run, and provide the server-side DSN below.
DR_SUPPORT_CASE_STORE=postgres
DR_SUPPORT_WORKSPACE_ID=

# PostgreSQL URL is server-side only. Leave blank to let the Windows launcher
# provision its project-owned local PostgreSQL service, or set a real external
# URL in a private environment. Never commit a real URL.
DR_SUPPORT_DATABASE_URL=
DR_SUPPORT_DATABASE_SCHEMA=dr_support
DR_SUPPORT_DATABASE_CONNECT_TIMEOUT=5

# Opt-in PostgreSQL integration tests. Both values are required and the database
# name must contain a distinct "test" token. Tests only create/drop unique schemas.
DR_SUPPORT_TEST_DATABASE_URL=
DR_SUPPORT_TEST_DATABASE_NAME=dr_support_test

# Optional CVAT Online integration for dense annotation. It is not required for
# offline operation and credentials remain server-side.
CVAT_URL=https://app.cvat.ai
CVAT_PROJECT_ID=
CVAT_TOKEN=

# Local model assets. The model server setup script writes these under
# local-state/bridge by default; override only with verified local paths.
RETFOUND_SOURCE=
RETFOUND_WEIGHTS=
PRISM_SOURCE=
PRISM_WEIGHTS=
PRISM_THRESHOLDS={}

# Hospital GPU runtime. Use cpu only for explicit local development/tests.
INFERENCE_DEVICE=cuda:0
MODEL_CPU_THREADS=4
MODEL_REQUIRE_VERIFIED_ASSETS=0
DR_SUPPORT_RELAX_DEVICE=0

# Optional review evidence limits; these bound displayed PRISM suggestions and
# do not change the underlying provider confidence values.
REVIEW_THRESHOLDS={}
REVIEW_MAX_PER_CLASS=25
REVIEW_MAX_TOTAL=80

# Local annotation-assist experiment; default OFF. Empirical rim output is shadow-only.
DR_SUPPORT_ANNOTATION_ASSIST_ARTIFACT_ROI=0

# =============================================================================
# Single-repo, multi-runtime-profile configuration.
#
# APP_PROFILE selects which surface this process exposes:
#   review     clinician workstation; UI + cases + review + CVAT + remote-proxy.
#              MUST run with MODEL_RUNTIME=remote and REMOTE_MODEL_URL set.
#   model_api  GPU deployment of the Remote Model API contract.
#              MUST run with MODEL_RUNTIME=local.
#   full       both surfaces mounted together for public/synthetic demos.
#              MUST run with MODEL_RUNTIME=local.
# =============================================================================
APP_PROFILE=review

# Server bind. review profile defaults to 8000; model_api profile defaults to 7860.
HOST=127.0.0.1
PORT=8000
WORKERS=1

# =============================================================================
# Inference runtime (depends on APP_PROFILE — see docs/PROFILES.md).
# =============================================================================
MODEL_RUNTIME=remote
MODEL_CPU_THREADS=4

# Remote-runtime configuration (review profile only). When MODEL_RUNTIME=remote,
# the backend proxies to this URL with an optional Bearer token from the env.
REMOTE_MODEL_URL=
REMOTE_MODEL_TOKEN=

# Persistent review state file. SQLite; one runtime worker per file.
DR_SUPPORT_STATE=

# =============================================================================
# CVAT Online round-trip (review profile only).
# =============================================================================
CVAT_URL=https://app.cvat.ai
CVAT_PROJECT_ID=445923
CVAT_TOKEN=

# =============================================================================
# Local model weights (model_api and full profiles only). The GPU deployment
# host runs `python -m dr_support.setup_models --model all` to populate these.
# NEVER commit the actual checkpoint files; only the pinned revisions/hashes.
# =============================================================================
RETFOUND_SOURCE=
RETFOUND_WEIGHTS=
PRISM_SOURCE=
PRISM_WEIGHTS=
PRISM_THRESHOLDS={}

# =============================================================================
# Clinician-side lesion-review policy (review / full profiles).
# =============================================================================
REVIEW_THRESHOLDS={}
REVIEW_MAX_PER_CLASS=25
REVIEW_MAX_TOTAL=80

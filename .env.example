# =============================================================================
# Single-repo, multi-runtime-profile configuration.
#
# APP_PROFILE selects which surface this process exposes:
#   review     clinician workstation; UI + cases + review + CVAT + remote-proxy.
#              MUST run with MODEL_RUNTIME=remote and REMOTE_MODEL_URL set.
#   model_api  GPU deployment of the Remote Model API contract.
#              MUST run with MODEL_RUNTIME=local.
#   full       both surfaces mounted together for public/synthetic demos.
#              MUST run with MODEL_RUNTIME=local.
# =============================================================================
APP_PROFILE=review

# Server bind. review profile defaults to 8000; model_api profile defaults to 7860.
HOST=127.0.0.1
PORT=8000
WORKERS=1

# =============================================================================
# Inference runtime (depends on APP_PROFILE — see docs/PROFILES.md).
# =============================================================================
MODEL_RUNTIME=remote
MODEL_CPU_THREADS=4

# Remote-runtime configuration (review profile only). When MODEL_RUNTIME=remote,
# the backend proxies to this URL with an optional Bearer token from the env.
REMOTE_MODEL_URL=
REMOTE_MODEL_TOKEN=

# Persistent review state file. SQLite; one runtime worker per file.
DR_SUPPORT_STATE=

# =============================================================================
# CVAT Online round-trip (review profile only).
# =============================================================================
CVAT_URL=https://app.cvat.ai
CVAT_PROJECT_ID=445923
CVAT_TOKEN=

# =============================================================================
# Local model weights (model_api and full profiles only). The GPU deployment
# host runs `python -m dr_support.setup_models --model all` to populate these.
# NEVER commit the actual checkpoint files; only the pinned revisions/hashes.
# =============================================================================
RETFOUND_SOURCE=
RETFOUND_WEIGHTS=
PRISM_SOURCE=
PRISM_WEIGHTS=
PRISM_THRESHOLDS={}

# =============================================================================
# GPU inference device resolver.
#   cuda:0   use the first CUDA GPU; the runtime fails loudly if none exists
#            (production behaviour; required for APP_PROFILE=model_api/full)
#   cpu      run on the CPU; only valid for local development / contract tests
#
# Anything else (mps, xpu, ...) is rejected at startup.
# =============================================================================
INFERENCE_DEVICE=cuda:0

# Test-only escape hatch. When set to "1", the model_api factory skips the
# startup CUDA assertion so contract tests can run on a CPU-only host.
# NEVER set this on the HF Docker Space deployment.
DR_SUPPORT_RELAX_DEVICE=0

# =============================================================================
# Modal deployment adapter (M0.6) — alternative to the HF Docker Space target.
#
# The Modal app is defined in ``modal_app.py`` and reuses the v0.4.0 Dockerfile
# via ``modal.Image.from_dockerfile``. Run ``modal deploy modal_app.py`` to ship
# the same model_api surface that ``Dockerfile`` builds for the HF Space.
#
# See ``docs/MODAL_DEPLOYMENT.md`` for the full runbook.
# =============================================================================

# Optional GPU override for the Modal deployment. Defaults to T4 (matches the
# HF Docker Space target). Accepted values: T4, L4, A10. Any other value is
# rejected — the adapter never silently changes hardware.
# MODAL_GPU=T4

# =============================================================================
# Lightning AI Studio deployment adapter (M0.7) — third deployment path.
#
# ``scripts/setup_lightning.sh`` prepares a Lightning Studio GPU workspace
# (venv + project install + idempotent model-source / weight acquisition).
# ``scripts/start_lightning.sh`` then launches the existing FastAPI
# ``model_api`` on ``0.0.0.0:8000``. The Studio's "Port" plugin exposes the
# public URL the clinician workstation copies into REMOTE_MODEL_URL below.
#
# See ``docs/LIGHTNING_DEPLOYMENT.md`` for the A–N operator runbook.
#
# Set the bearer-token secret inside the Studio's environment variables panel
# before running the launch script. The token is never echoed, logged, or
# committed by either script.
# =============================================================================

# =============================================================================
# Clinician-side lesion-review policy (review / full profiles).
# =============================================================================
REVIEW_THRESHOLDS={}
REVIEW_MAX_PER_CLASS=25
REVIEW_MAX_TOTAL=80

# Preserve byte-pinned upstream algorithms on Windows checkouts.
# artifact_core_v01.py and artifact_generic_v01/core.py are byte-identical on purpose: each is a separate
# pinned upstream copy, so neither is renamed, edited or deduplicated.
dr_support/services/artifact_core_v01.py text eol=lf
dr_support/services/artifact_rim_shadow_v01.py text eol=lf
dr_support/services/artifact_generic_v01/core.py text eol=lf
dr_support/services/artifact_generic_v01/generic_uwf.py text eol=lf

# Keep qualified finite-QA control sources byte-identical across checkouts.
scripts/qa/batch_runtime/*.py text eol=lf

# Shell scripts run on Linux hosts or are piped there over SSH: always LF.
*.sh text eol=lf

# S8 TEMPLATE — paths/user/env must be rewritten for the hospital server.
[Unit]
Description=DR Support Model API
After=network.target

[Service]
Type=simple
User=drsupport
WorkingDirectory=/opt/dr-support-screening-poc
EnvironmentFile=/etc/dr-support/model-api.env
ExecStart=/opt/dr-support-screening-poc/scripts/model-server/start.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
